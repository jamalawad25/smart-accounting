<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SmartAccounting" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/navy_900</item>
        <item name="colorPrimaryVariant">@color/navy_800</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/sky_500</item>
        <item name="colorSecondaryVariant">@color/teal_600</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/navy_900</item>
        <item name="android:windowBackground">@color/slate_100</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/slate_200</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">14dp</item>
    </style>
</resources>